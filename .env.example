# aROMa: the one file that configures everything. Copy it to .env and fill in what you need.
# On the server, `docker compose up -d --build` then does the rest (database, migrations, bot, web app).

# --- Database (docker compose creates it with these credentials) ---
DB_NAME=aroma_bot
DB_USER=alan
DB_PASSWORD=change-me

# --- Telegram ---
BOT_TOKEN=your_real_bot_token_here
GROUP_ID=-1001457029650
# Only for a test bot run with TEST=1 on your own machine:
# TEST_BOT_TOKEN=
# TEST_GROUP_ID=

# --- Web app ---
# The public address of the web app: the bot's login links and the Nostr badge pictures point here.
# Leave it empty with the ngrok profile below: the bot then reads the address from the tunnel.
WEBAPP_URL=https://aroma.example.org
# Signs the login cookie. Use a long random string (python3 -c "import secrets; print(secrets.token_hex(32))")
WEBAPP_SECRET=change-me-to-a-long-random-string
WEBAPP_PORT=8080
# The bot's username (no @): the games catalogue links each game to the bot's card for it.
BOT_USERNAME=

# Make the web app reachable from anywhere without opening ports on the router: create a free Cloudflare
# tunnel (Zero Trust > Networks > Tunnels), point its public hostname to http://web:8080, paste its token here
# and enable the profile. See webapp/README.md.
# COMPOSE_PROFILES=tunnel
# CLOUDFLARE_TUNNEL_TOKEN=

# Or, the quickest way, ngrok (https://dashboard.ngrok.com/get-started/your-authtoken): enable the profile, paste the
# authtoken and empty WEBAPP_URL above. A free static domain (NGROK_DOMAIN) keeps the address from changing.
# COMPOSE_PROFILES=ngrok
# NGROK_AUTHTOKEN=
# NGROK_DOMAIN=

# Without any account: a Cloudflare quick tunnel, random address (COMPOSE_PROFILES=quicktunnel, WEBAPP_URL empty).

# --- Nostr badges (optional: without NOSTR_NSEC the /nostr button stays inactive) ---
# NOSTR_NSEC=nsec1...
# NOSTR_RELAYS=wss://relay.damus.io,wss://nos.lol,wss://relay.primal.net
# The badge pictures are served by the web app at WEBAPP_URL/badges; override only to host them elsewhere:
# NOSTR_BADGE_IMAGE_BASE=https://example.org/badges

# --- Marvel season ---
# Set to 1 ONCE to launch it: a database backup is taken first (backups/), then the season wipe runs and is
# remembered in the database, so leaving it at 1 never wipes twice.
MARVEL_LAUNCH=0

# --- Pictures ---
# Marvel illustrations are downloaded on the first start. A free key makes it take minutes instead of hours:
# https://enter.pollinations.ai/keys
# POLLINATIONS_API_KEY=
FETCH_IMAGES=1
